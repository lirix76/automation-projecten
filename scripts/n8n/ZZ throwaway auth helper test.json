      "name": "Auth test",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "\n// Throwaway: verify httpRequestWithAuthentication resolves the Google Drive OAuth2 credential.\ntry {\n  const res = await this.helpers.httpRequestWithAuthentication.call(this, 'googleDriveOAuth2Api', {\n    method: 'GET',\n    url: 'https://www.googleapis.com/drive/v3/about',\n    qs: { fields: 'user' },\n    json: true,\n  });\n  return [{ json: { ok: true, authedAs: res.user } }];\n} catch (e) {\n  return [{ json: { ok: false, error: e.message, status: e.httpCode || e.statusCode || null } }];\n}\n"
      }
    },
    {
      "id": "rw",
      "name": "Respond",
